# Copy to android/keystore.properties (gitignored) -- NEVER commit the real file.
# Every key can instead come from the environment variable in brackets.

# [NEOWATCH_KEYSTORE] the EXISTING upload/signing key (same SHA-256 as assetlinks.json)
storeFile=/Users/neo/Documents/VsCodeN30/neowatch-signing/signing.keystore
# [NEOWATCH_KEY_ALIAS]
keyAlias=my-key-alias

# Passwords: EITHER point at the PWABuilder note that already holds them
# ("Key store password:" / "Key password:" lines) so they live in ONE place ...
# [NEOWATCH_SIGNING_INFO]
passwordsFrom=/Users/neo/Documents/VsCodeN30/neowatch-signing/signing-key-info.txt
# ... OR give them directly ([NEOWATCH_KEYSTORE_PASSWORD] / [NEOWATCH_KEY_PASSWORD]):
# storePassword=
# keyPassword=

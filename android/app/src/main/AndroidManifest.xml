<?xml version="1.0" encoding="utf-8"?>
<!-- NEOWATCH Android TV shell: one Activity hosting the system WebView.
     Package co.soclose.neowatch.twa is FROZEN (Sentinel House + assetlinks.json). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Runs on phones/tablets too; leanback + no touchscreen keep it listed on TVs. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NeoWatch"
        android:usesCleartextTraffic="false">

        <meta-data android:name="android.webkit.WebView.EnableSafeBrowsing" android:value="true" />
        <meta-data android:name="android.webkit.WebView.MetricsOptOut" android:value="true" />

        <!-- Same class name as the v1/v2 TWA launcher (co.soclose.neowatch.twa.LauncherActivity),
             so pinned launcher entries and any `am start -n` keep resolving after the update. -->
        <activity
            android:name=".LauncherActivity"
            android:banner="@drawable/banner"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- Verified app links (assetlinks.json): https://neowatch.soclose.co/* opens HERE,
                 e.g. Sentinel House's https://neowatch.soclose.co/chaine/<id>. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="neowatch.soclose.co" />
            </intent-filter>
        </activity>

        <!-- HOME-SCREEN WIDGETS (v2.1.0, phones). Adapted from the Sentinel House widget kit.
             The three providers are exported by necessity (the launcher sends them
             APPWIDGET_UPDATE); they only DRAW from a cache and ask WidgetJob for a read, and read
             no extra. Taps open a NEOWATCH page in LauncherActivity (explicit intent) or go to
             WidgetActions (NOT exported: refresh + redraw tick only). The options screen is opened
             by the launcher (APPWIDGET_CONFIGURE) and stores channel ids, never a token.
             Android TV: the leanback launcher hosts no widgets, so none of this runs there. -->
        <receiver
            android:name=".WidgetDirect"
            android:exported="true"
            android:label="@string/w_direct_nom">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_direct" />
        </receiver>
        <receiver
            android:name=".WidgetMesChaines"
            android:exported="true"
            android:label="@string/w_mes_nom">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_mes_chaines" />
        </receiver>
        <receiver
            android:name=".WidgetChaine"
            android:exported="true"
            android:label="@string/w_chaine_nom">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_chaine" />
        </receiver>
        <receiver
            android:name=".WidgetActions"
            android:exported="false" />
        <service
            android:name=".WidgetJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <activity
            android:name=".WidgetConfigActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/app_name"
            android:taskAffinity=""
            android:theme="@style/Theme.NeoWatch.Options"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>
</manifest>

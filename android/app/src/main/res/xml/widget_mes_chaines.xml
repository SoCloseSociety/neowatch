<?xml version="1.0" encoding="utf-8"?>
<!-- "My channels" widget: S = 1 channel, M = 4, L = 8. The options screen (search + pick) opens when
     it is placed and on a long press. 30 min period (the kit's), plus a manual refresh. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:maxResizeWidth="1000dp"
    android:maxResizeHeight="1000dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_cadre"
    android:previewLayout="@layout/widget_apercu_mes_chaines"
    android:description="@string/w_mes_desc"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable"
    android:configure="co.soclose.neowatch.twa.WidgetConfigActivity" />

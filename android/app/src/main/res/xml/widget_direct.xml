<?xml version="1.0" encoding="utf-8"?>
<!-- "Live now" widget. Adapted from the Sentinel House widget kit (xml/widget_direct.xml).
     4x2 by default, resizable (S / M / L drawings). updatePeriodMillis = 30 min, the kit's period
     (and Android's floor); a manual refresh is on the card. The options screen (style, logos)
     opens when it is placed, NOT optional: measured on an API 34 emulator, a never-opened app sits
     in the NEVER standby bucket and JobScheduler runs none of its jobs, so the widget stayed on
     "Loading". Opening the options screen makes the app active and the first read runs. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:maxResizeWidth="1000dp"
    android:maxResizeHeight="1000dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_cadre"
    android:previewLayout="@layout/widget_apercu_direct"
    android:description="@string/w_direct_desc"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable"
    android:configure="co.soclose.neowatch.twa.WidgetConfigActivity" />

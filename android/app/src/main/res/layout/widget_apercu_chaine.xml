<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview of the 1x1 channel shortcut (static sample). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_fond"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="4dp">

    <TextView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/w_plaque" android:fontFamily="@font/plex_mono_medium" android:gravity="center" android:text="F2" android:textColor="@color/w_texte2" android:textSize="14sp" />

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="4dp" android:contentDescription="@null" android:src="@drawable/w_point" android:tint="@color/w_live" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/plex_mono_medium" android:text="@string/w_etat_live" android:textAllCaps="true" android:textColor="@color/w_live" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>

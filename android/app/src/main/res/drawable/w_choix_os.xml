<?xml version="1.0" encoding="utf-8"?>
<!-- Configuration screen: the chosen option and the Done button, the bone primary (never mint:
     mint is the OK state only). Focus: a bone ring detached by a dark gap. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="2dp" android:color="@color/w_os" />
                    <corners android:radius="15dp" />
                </shape>
            </item>
            <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/w_os" />
                    <corners android:radius="11dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/w_os" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>

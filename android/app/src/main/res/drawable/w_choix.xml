<?xml version="1.0" encoding="utf-8"?>
<!-- Configuration screen: a choice not taken (bg-2, a line). Focus: a bone ring. Pressed: bg-3. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/w_plaque" />
            <stroke android:width="2dp" android:color="@color/w_os" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/w_plaque" />
            <stroke android:width="1dp" android:color="@color/w_ligne" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/w_surface" />
            <stroke android:width="1dp" android:color="@color/w_ligne" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>

# ── NEOWATCH configuration ───────────────────────────────────────────────
# Copy to .env and adjust. All values are optional (sane defaults baked in).

# Node environment. "production" enforces an explicit JWT_SECRET at boot and
# persists sessions across restarts; "development" auto-generates an ephemeral
# secret (tokens reset on restart).
NODE_ENV=development

# Port the API/proxy server listens on (in production it also serves the built web app).
PORT=8787

# How long (hours) the iptv-org catalog is cached on disk before refetch.
CATALOG_TTL_HOURS=12

# Base of the iptv-org public API (no trailing slash).
IPTV_API_BASE=https://iptv-org.github.io/api

# Hide adult (NSFW) channels everywhere. Strongly recommended to keep true.
HIDE_NSFW=true

# Comma-separated allowed origins for CORS in production (empty = same-origin only).
ALLOWED_ORIGINS=

# Express "trust proxy" so rate limiting sees the real client IP behind nginx.
# e.g. 1 (one proxy hop) or "loopback". Leave empty if not behind a proxy.
TRUST_PROXY=

# Let ADMIN-added M3U sources and XMLTV guides point at private/LAN hosts (your own
# provider on the local network), and let the proxy + health probes reach the streams
# of those custom sources. iptv-org and radio streams keep the full SSRF guard either
# way. Off by default. Set true only for a provider you trust.
ALLOW_PRIVATE_SOURCES=false

# ── Authentication & accounts ──────────────────────────────────────────
# When true, the catalog, guide, films and radio require a signed-in user (a closed instance; pair
# it with ALLOW_REGISTER=false). The stream proxy is never behind it: its links are signed.
REQUIRE_AUTH=false
# Allow visitors to self-register a free account.
ALLOW_REGISTER=true
# REQUIRED in production: a long random secret so JWT tokens + signed proxy URLs
# survive restarts. If empty in dev, a random one is generated each boot.
JWT_SECRET=
# Token lifetime (e.g. 7d, 24h). Shorter = smaller blast radius if a token leaks.
# ALWAYS write a unit: a bare number ("604800") is read as MILLISECONDS by jsonwebtoken
# (the server warns at boot). Sessions slide: a token that is USED past JWT_RENEW_AFTER is
# replaced by a fresh one (so a TV opened at least once per period stays signed in); a token
# left unused expires at JWT_TTL. Password change / admin reset / disable revoke every
# existing token (and every TV pairing approved but not yet collected).
JWT_TTL=7d
# Age after which a used token is renewed (e.g. 1d, 12h). Empty = half of JWT_TTL.
# Should be > 0 and < JWT_TTL: 0 renews on every request, >= JWT_TTL turns sliding off.
# Out-of-range values are WARNED about at boot, not refused.
JWT_RENEW_AFTER=
# Optional: where runtime state (accounts, sources, EPG) and the catalog cache live.
# Defaults: server/.data and server/.cache. Useful for a throwaway test server.
DATA_DIR=
CACHE_DIR=
# Optional dedicated secret for HMAC proxy-URL signing (defaults to a value
# derived from JWT_SECRET, so key separation holds without setting this).
SIGNING_SECRET=
# First-boot admin account. If ADMIN_PASSWORD is empty, a random one is printed once.
ADMIN_EMAIL=admin@neowatch.local
ADMIN_PASSWORD=
# Imported M3U sources are Premium by default (set false to make them free).
# This is the ONLY content that can be locked: every public (iptv-org) channel is free.
CUSTOM_PREMIUM=true

# ── Monetization ───────────────────────────────────────────────────────
# Premium sells account FEATURES (pinned/hidden categories, start page, preferences on
# every device, no ads when ads run), never access to public channels.
# PREMIUM_CATEGORIES is DEPRECATED: it locks nothing (kept only in /api/config for
# compatibility). Leave it unset.
PREMIUM_PRICE=4.99
PREMIUM_CURRENCY=EUR
PREMIUM_PERIOD_DAYS=30
# Public origin (used for Stripe success/cancel URLs).
PUBLIC_URL=https://neowatch.soclose.co
# Billing provider: "mock" (instant Premium, no payment) or "stripe" (real).
# Mock checkout is REFUSED when NODE_ENV=production unless ALLOW_MOCK_BILLING=true
# (an explicit "free beta"); /api/config then reports billing.checkout=false.
BILLING_PROVIDER=mock
ALLOW_MOCK_BILLING=
STRIPE_SECRET=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Google AdSense publisher id (ca-pub-...): FREE users only, after consent, never on TV.
ADSENSE_CLIENT=
# Published Android shell path (sent in /api/config so the install panel links it), e.g. /app.apk.
# Leave empty when no APK is hosted.
ANDROID_APK=

# ── Health sweep / EPG ─────────────────────────────────────────────────
HEALTH_SWEEP=false
HEALTH_SWEEP_INTERVAL_HOURS=6
# Sweep tuning (lower = gentler on CPU/bandwidth).
SWEEP_BATCH_SIZE=60
SWEEP_CONCURRENCY=8
# Optional default XMLTV EPG (your provider's guide or a public aggregator), refreshed every 6h.
EPG_DEFAULT_URL=
EPG_DEFAULT_TZ_MINUTES=0
